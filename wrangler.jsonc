// CaOS の配信（Cloudflare：cafeore のアカウント）。画面（dist）と盤面（Durable Object）を 1 つの Worker で出す。
// main に push すると GitHub Actions がデプロイする（CLOUDFLARE_API_TOKEN・CLOUDFLARE_ACCOUNT_ID）。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* は静的ファイルより先に Worker が受ける
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardObject"] }],
  "vars": {
    "POS_API_BASE_URL": "https://cafeore-pos-git-czojooivca-an.a.run.app",
    "ALLOWED_ORIGINS": ""
  },
  "observability": { "enabled": true }
}
